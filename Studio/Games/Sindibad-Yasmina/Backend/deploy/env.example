# Copy to .env (setup.sh does this and fills in the secrets).

# The server's address, pointing at this VPS (an A record). Without a domain
# of your own, <the VPS address with dashes>.sslip.io works, for example
# 203-0-113-5.sslip.io for 203.0.113.5.
API_DOMAIN=api.example.org

# Long random strings: openssl rand -hex 24
POSTGRES_PASSWORD=
ADMIN_TOKEN=

# How much the server logs: info (every request and every report from the
# devices), or debug for everything, database included:
#   RUST_LOG=debug,hyper=info,h2=info
RUST_LOG=info
# json (for jq) or text
LOG_FORMAT=json
